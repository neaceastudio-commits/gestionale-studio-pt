# Verifica della sessione firmata ricevuta dalla Dashboard/Portale PT.
# Facoltativa: se vuota viene usata la funzione pt-access-email del Portale PT.
PT_ACCESS_VERIFY_URL=
# Obbligatoria per pt-access-email e pt-data: firma e verifica le sessioni PT.
PT_ACCESS_SECRET=

# API server-side del Portale Nutrizione / Gestione Scadenze.
SCADENZE_API_URL=
SCADENZE_API_TOKEN=

# Supabase Studio: variabili esclusivamente server-side per Anamnesi Cliente e Portale PT.
# Non inserire mai SUPABASE_SECRET_KEY nel codice pubblicato nel browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# In alternativa a SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=

# Facoltativo: numero massimo di anagrafiche dettagliate controllate nella ricerca per CF.
NUTRITION_CF_SCAN_LIMIT=160
